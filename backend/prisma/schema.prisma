generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // For local zero-config dev without Postgres, switch to:
  // provider = "sqlite"
  // url      = "file:./dev.db"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  pinHash      String?
  name         String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  projects     Project[]
  trades       Trade[]
  analyses     Analysis[]
  sessions     Session[]
  // WebAuthn
  webauthnCredential String? @db.Text
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  market         String?  // e.g. NSE, Crypto, Forex
  startingBalance Float   @default(0)
  currency       String   @default("USD")
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trades         Trade[]
  analyses       Analysis[]
  @@unique([userId, name])
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  market      String   // NSE, NASDAQ, Forex, Crypto etc
  instrument  String   // RELIANCE, BTCUSD, EURUSD etc
  side        String   // BUY / SELL
  entryPrice  Float
  exitPrice   Float?
  quantity    Float
  stopLoss    Float?
  target      Float?
  charges     Float    @default(0)
  strategy    String?
  emotions    String?
  notes       String?  @db.Text
  status      String   @default("OPEN") // OPEN, CLOSED
  pnl         Float?
  pnlPercent  Float?
  screenshots String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, projectId])
  @@index([date])
}

model Analysis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  notes       String?  @db.Text
  tags        String[] @default([])
  imageUrl    String
  imagePublicId String?
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}
